{
  "imports": {
    "zod": "npm:zod@^4.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-console", "explicit-function-return-type"]
    }
  },
  "fmt": {
    "singleQuote": true,
    "lineWidth": 100
  }
}
