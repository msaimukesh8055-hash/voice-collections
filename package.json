{
  "name": "voice-collections",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w web",
    "test": "vitest run --coverage && npm run test -w web",
    "check:secrets": "node --env-file-if-exists=.env scripts/check-bundle-secrets.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fn:lint": "cd supabase/functions && deno lint",
    "fn:fmt": "cd supabase/functions && deno fmt --check",
    "fn:check": "cd supabase/functions && deno check **/*.ts",
    "fn:test": "cd supabase/functions && deno test --coverage=../../coverage/functions",
    "fn:coverage": "cd supabase/functions && deno coverage ../../coverage/functions",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:secrets && npm run fn:fmt && npm run fn:lint && npm run fn:check && npm run fn:test",
    "db:push": "node --env-file=.env scripts/db-push.ts",
    "db:check-seed": "node --env-file=.env scripts/check-seed.ts",
    "functions:deploy": "node --env-file=.env scripts/functions-deploy.ts",
    "agent:build": "node --env-file=.env scripts/agent-build.ts",
    "agent:record": "node --env-file=.env scripts/agent-record.ts",
    "seed:generate": "node scripts/seed/write-seed.ts",
    "smoke:tools": "node --env-file=.env scripts/smoke-tools.ts",
    "smoke:whatsapp": "node --env-file=.env scripts/smoke-whatsapp.ts",
    "spike:voice": "node --env-file=.env scripts/spike-voice.ts",
    "smoke:reminders": "node --env-file=.env scripts/smoke-reminders.ts",
    "smoke:munshi-latency": "node --env-file=.env scripts/smoke-munshi-latency.ts",
    "evals:munshi": "node --env-file-if-exists=.env evals/munshi/run.ts",
    "evals:asha": "node --env-file=.env evals/sarvam/run.ts",
    "evals:brain": "node --env-file=.env evals/brain/run.ts",
    "brand:png": "node scripts/brand-png.ts",
    "bot:profile": "node --env-file-if-exists=.env scripts/bot-profile.ts",
    "whatsapp:commands": "node --env-file-if-exists=.env scripts/whatsapp-commands.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "2.6.2",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^4.1.12",
    "deno": "^2.9.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
