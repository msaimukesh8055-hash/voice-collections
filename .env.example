# .env.example — copy to .env and fill in. Never commit .env.

# Supabase (Settings → API Keys; project ref is the id in the project URL).
# Project lives in Mumbai (ap-south-1), next to Sarvam (ADR-0008).
SUPABASE_URL=
SUPABASE_REGION=ap-south-1
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Account preferences → Access Tokens (scoped: Project read, Database + Application services write)
SUPABASE_ACCESS_TOKEN=

# Dashboard and phone page — public values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_REGION=ap-south-1

# Sarvam (dashboard.sarvam.ai → API keys): speech-to-text, text-to-speech, sarvam-105b
SARVAM_API_KEY=
# Sarvam Voice Agents (indus.sarvam.ai): only calls-api uses it, to fetch a call URL for the
# phone page. Never sent to the browser.
SARVAM_AGENTS_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# Asha's app id in Sarvam. Blank until the agent is created; calls are refused until it is set.
SARVAM_APP_ID=
# Bearer secret Sarvam sends on every tool call (random, 32+ chars). Same value goes in Sarvam's
# Secrets vault as "easy-recovery-tool-secret". npm run functions:deploy uploads it.
SARVAM_TOOL_SECRET=

# WhatsApp owner bot (M4, Meta Cloud API test number). npm run functions:deploy uploads these.
# System-user token with whatsapp_business_messaging + whatsapp_business_management, never expires.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# App dashboard → App settings → Basic → App ID (not secret). Only npm run bot:profile uses it
# (M7), for the profile-photo upload session; it is not a function secret.
META_APP_ID=
# App settings → Basic → App secret: checks X-Hub-Signature-256 on every webhook POST.
META_APP_SECRET=
# Any random string; pasted once in Meta → WhatsApp → Configuration → Verify token.
WHATSAPP_VERIFY_TOKEN=
# The only number the bot answers (digits with country code). Never stored or logged.
OWNER_WHATSAPP_NUMBER=
# M9: who gets failure alerts (digits with country code). Blank = the owner's number above.
# It must be one of the numbers registered on the Meta test number.
OPS_ALERT_WHATSAPP_NUMBER=

# Follow-up worker (M5): random, 32+ chars. calls-api and whatsapp-webhook send it as a bearer
# token (call ended, Remind, simulated calls); followup-worker refuses any request without it.
# npm run functions:deploy uploads it. pg_cron reads the same value from Supabase Vault
# ("worker_secret"), set once by hand: see README "Scheduler".
WORKER_SECRET=

# Web dashboard link (M6): the bot sends the owner <DASHBOARD_URL>/#t=<token>, signed with
# DASHBOARD_LINK_SECRET (random, 32+ chars; calls-api checks it). The link works for 24 hours.
# DASHBOARD_URL is the web app's address: http://localhost:5173 locally, the Vercel production
# address once deployed (docs/deploy-vercel.md).
# npm run functions:deploy uploads both.
DASHBOARD_LINK_SECRET=
DASHBOARD_URL=
# Public demo: "on" lets anyone with the web address see the dashboard, customers, calls and
# transcripts, and use the "English under Telugu" switch, without the WhatsApp link (fake data only).
# To lock it again, set it to "off" (not blank: a blank value is not uploaded) and redeploy.
DASHBOARD_PUBLIC=

# Munshi, the owner's call line (M8, ADR-0018). npm run functions:deploy uploads all three.
# MUNSHI_LINK_SECRET signs the one-time <DASHBOARD_URL>/munshi#t=<token> links (random, 32+
# chars; whatsapp-webhook signs, calls-api checks). SARVAM_OWNER_TOOL_SECRET is the bearer secret
# Sarvam sends on Munshi's tool calls (random, 32+ chars, different from SARVAM_TOOL_SECRET); the
# same value goes in Sarvam's Secrets vault as "easy-recovery-owner-tool-secret".
# SARVAM_MUNSHI_APP_ID is Munshi's app id in Sarvam: blank until the agent is created; until then
# "Call Munshi" says it is not set up yet.
MUNSHI_LINK_SECRET=
SARVAM_OWNER_TOOL_SECRET=
SARVAM_MUNSHI_APP_ID=

# Gemini (aistudio.google.com; no billing account) — eval judge and fallback only.
GEMINI_API_KEY=

# Origins allowed to call calls-api from a browser (comma-separated, exact, no trailing slash; not
# secret). Add the Vercel production origin (https://<project>.vercel.app) when deployed.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
