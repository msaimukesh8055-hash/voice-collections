# .env.example — copy to .env and fill in. Never commit .env.

# Supabase (Settings → API Keys; project ref is the id in the project URL)
SUPABASE_URL=
SUPABASE_REGION=us-west-2
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Account preferences → Access Tokens (scoped: Project read, Database + Application services write)
SUPABASE_ACCESS_TOKEN=

# Dashboard — public values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_REGION=us-west-2

# Vapi (dashboard → Org → API Keys)
VAPI_PRIVATE_KEY=
VITE_VAPI_PUBLIC_KEY=
# Shared secret Vapi sends to our webhook (random, 32+ chars; npm run functions:deploy uploads it)
VAPI_WEBHOOK_SECRET=

# Gemini (aistudio.google.com; no billing account) — summaries, follow-ups, embeddings, evals.
# Not used by the live voice agent (Vapi-hosted model, ADR-0007).
GEMINI_API_KEY=

# Dashboard origins allowed to call calls-api from a browser (comma-separated; not secret)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
