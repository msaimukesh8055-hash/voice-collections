# .env.example — copy to .env and fill in. Never commit .env.

# Supabase (Settings → API Keys; project ref is the id in the project URL).
# Project lives in Mumbai (ap-south-1), next to Sarvam (ADR-0008).
SUPABASE_URL=
SUPABASE_REGION=ap-south-1
SUPABASE_PROJECT_REF=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Account preferences → Access Tokens (scoped: Project read, Database + Application services write)
SUPABASE_ACCESS_TOKEN=

# Dashboard and phone page — public values only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_REGION=ap-south-1

# Sarvam (dashboard.sarvam.ai → API keys): speech-to-text, text-to-speech, sarvam-105b
SARVAM_API_KEY=
# Sarvam Voice Agents (indus.sarvam.ai): only calls-api uses it, to fetch a call URL for the
# phone page. Never sent to the browser.
SARVAM_AGENTS_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
# Asha's app id in Sarvam. Blank until the agent is created; calls are refused until it is set.
SARVAM_APP_ID=
# Bearer secret Sarvam sends on every tool call (random, 32+ chars). Same value goes in Sarvam's
# Secrets vault as "easy-recovery-tool-secret". npm run functions:deploy uploads it.
SARVAM_TOOL_SECRET=

# WhatsApp owner bot (M4, Meta Cloud API test number). npm run functions:deploy uploads these.
# System-user token with whatsapp_business_messaging + whatsapp_business_management, never expires.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# App settings → Basic → App secret: checks X-Hub-Signature-256 on every webhook POST.
META_APP_SECRET=
# Any random string; pasted once in Meta → WhatsApp → Configuration → Verify token.
WHATSAPP_VERIFY_TOKEN=
# The only number the bot answers (digits with country code). Never stored or logged.
OWNER_WHATSAPP_NUMBER=

# Gemini (aistudio.google.com; no billing account) — eval judge and fallback only.
GEMINI_API_KEY=

# Origins allowed to call calls-api from a browser (comma-separated; not secret)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
